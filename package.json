{
  "name": "paradigma",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:loja": "npm run dev -w @paradigma/loja",
    "dev:admin": "npm run dev -w @paradigma/admin",
    "build": "npm run typecheck && npm run build --workspaces --if-present",
    "build:loja": "npm run typecheck && npm run build -w @paradigma/loja",
    "build:admin": "npm run typecheck && npm run build -w @paradigma/admin",
    "typecheck": "tsc --noEmit",
    "test:ui": "playwright test",
    "test:db": "node --test tests/database/*.test.mjs",
    "test:supabase": "node --env-file=.env.test.local tests/integration/supabase.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
